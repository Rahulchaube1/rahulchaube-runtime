{
  "name": "rahulchaube-cli",
  "version": "1.3.0",
  "description": "Compatibility CLI for RC Runtime (RahulChaube Runtime), including Blyx and Bun-hosted tooling.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rahulchaube": "./bin/package-cli.ts"
  },
  "files": [
    "bin",
    "blyx",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "bun ./bin/package-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "workspaces": [],
  "keywords": [
    "rahulchaube",
    "runtime",
    "javascript",
    "typescript",
    "package-manager",
    "bundler"
  ],
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "~5.9.3"
  }
}
