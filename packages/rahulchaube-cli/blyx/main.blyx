use std::cli;
use std::fs;
use std::text;
use metadata;
use options;
use engine;
use execute;

fn compiler() -> String {
    env_get("BLYXC", path_join(exe_dir(), compiler_filename()))
}

fn legacy(argv: arglist) {
    let prefix = args_push(args_push(args_new(), "run"), path_join(exe_dir(), "rahulchaube.ts"));
    process_exec("bun", args_concat(prefix, argv), args_new());
}

fn colors_enabled() -> bool {
    return env_get("NO_COLOR", "") == "" && (env_get("FORCE_COLOR", "") == "1" || (stdout_terminal() && env_get("TERM", "") != "dumb"));
}

fn main() {
    let argv = cli_args();
    if args_len(argv) == 0 { print!(help_text(colors_enabled())); return; }
    let command = args_at(argv, 0);
    if command == "--version" || command == "-v" { print!(version_text(colors_enabled())); return; }
    if command == "--help" || command == "-h" { print!(help_text(colors_enabled())); return; }
    let raw = args_tail(argv, 1);
    if command == "blyx" {
        if args_len(raw) == 0 { process_exec(compiler(), args_push(args_new(), "--help"), args_new()); }
        process_exec(compiler(), raw, args_new());
    }
    if command != "add" && command != "remove" && command != "update" && command != "test" && command != "build" && command != "run" {
        legacy(argv);
        return;
    }
    let opts = parse_args(command, raw, true);
    if option(opts, "help") != "" || option(opts, "h") != "" {
        print!(help_text(colors_enabled() && option(opts, "no-color") == ""));
        return;
    }
    let inputs = parse_args(command, raw, false);
    if (command == "run" || command == "build") && args_len(inputs) > 0 && text_ends(args_at(inputs, 0), ".blyx") {
        let source = args_item(inputs, 0);
        let mut xs = args_new();
        if command == "run" {
            xs = args_push(args_concat(args_push(xs, "native-run"), source), "--");
            xs = args_concat(xs, args_tail(inputs, 1));
        } else {
            if args_len(inputs) != 1 { stderr_line("[ERR] A Blyx build takes one entry file."); process_exit(1); }
            xs = args_concat(args_push(xs, "build"), source);
            let output = option(opts, "outfile");
            if output != "" { xs = args_push(args_push(xs, "-o"), output); }
        }
        let mut i = 0;
        while i < args_len(opts) {
            let key = args_at(opts, i);
            if key != "no-color" && key != "debug" && (command != "build" || key != "outfile") {
                stderr_line(text_concat(text_concat(text_concat("[ERR] Unsupported Blyx ", command), " option: --"), key));
                process_exit(1);
            }
            i += 2;
        }
        process_exec(compiler(), xs, args_new());
    }
    if command == "run" { execute_script(inputs, opts); }
    if command == "run" || (command == "build" && (option(opts, "watch") != "" || option(opts, "w") != "")) {
        legacy(argv);
        return;
    }
    process_exit(engine_command(command, inputs, opts));
}
