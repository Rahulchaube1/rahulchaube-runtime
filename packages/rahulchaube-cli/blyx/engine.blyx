use std::cli;
use std::text;
use options;

// Bun supplies the package manager, JavaScript bundler and test runner.
pub fn engine_command(command: String, inputs: arglist, opts: arglist) -> i64 {
    let mut xs = args_push(args_new(), command);
    let mut target = args_join(inputs, ", ");
    let mut success = "";
    let mut failure = "";
    if command == "add" {
        if args_len(inputs) == 0 { stderr_line("[ERR] Usage: rahulchaube add <package...> [--dev]"); return 1; }
        xs = engine_flag(engine_flag(xs, opts, "dev"), opts, "exact");
        println!(text_concat(text_concat("[pkg] Adding ", target), "…"));
        success = "[OK] Added ";
        failure = "[ERR] Add failed.";
    } else if command == "remove" {
        if args_len(inputs) == 0 { stderr_line("[ERR] Usage: rahulchaube remove <package...>"); return 1; }
        println!(text_concat(text_concat("[pkg] Removing ", target), "…"));
        success = "[OK] Removed ";
        failure = "[ERR] Remove failed.";
    } else if command == "update" {
        xs = engine_flag(engine_flag(xs, opts, "interactive"), opts, "latest");
        if args_len(inputs) == 0 { target = "all dependencies"; }
        println!(text_concat(text_concat("[reload] Updating ", target), "…"));
        success = "[OK] Updated ";
        failure = "[ERR] Update failed.";
    } else if command == "test" {
        xs = engine_flag(engine_flag(xs, opts, "watch"), opts, "coverage");
        println!("[INFO] [test] Launching test suite…");
    } else {
        let outfile = option(opts, "outfile");
        let outdir = option(opts, "outdir");
        if outfile != "" { xs = args_push(args_push(xs, "--outfile"), outfile); }
        else if outdir != "" { xs = args_push(args_push(xs, "--outdir"), outdir); }
        xs = engine_flag(xs, opts, "compile");
        if option(opts, "target") != "" { xs = args_push(args_push(xs, "--target"), option(opts, "target")); }
        xs = engine_flag(engine_flag(engine_flag(xs, opts, "minify"), opts, "sourcemap"), opts, "splitting");
        target = args_join(inputs, " ");
        if target == "" { target = "project"; }
        println!(text_concat(text_concat("[INFO] [build] Building ", target), "…"));
    }
    let mut env = args_push(args_push(args_new(), "RAHULCHAUBE_BRAND_ACTIVE"), "1");
    if option(opts, "no-color") != "" { env = args_push(args_push(env, "NO_COLOR"), "1"); }
    let status = process_run(env_get("RAHULCHAUBE_ENGINE", "bun"), args_concat(xs, inputs), env);
    if status == 0 && success != "" { println!(text_concat(text_concat(success, target), ".")); }
    if status != 0 && failure != "" { stderr_line(failure); }
    status
}
