{
  "openapi": "3.0.3",
  "info": {
    "title": "RC Runtime API",
    "version": "1.3.0",
    "description": "Production REST API for RC Runtime release management, telemetry, and developer services."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Version information",
        "responses": { "200": { "description": "Version details" } }
      }
    },
    "/api/releases": {
      "get": {
        "summary": "List official releases",
        "responses": { "200": { "description": "Releases list" } }
      }
    },
    "/api/download": {
      "get": {
        "summary": "Download links matrix",
        "responses": { "200": { "description": "Platform download URLs" } }
      }
    },
    "/api/checksum": {
      "get": {
        "summary": "Release SHA256 checksums",
        "responses": { "200": { "description": "Checksum map" } }
      }
    },
    "/api/plugins": {
      "get": {
        "summary": "Official CLI plugins",
        "responses": { "200": { "description": "Plugins list" } }
      }
    },
    "/api/templates": {
      "get": {
        "summary": "Available project starter templates",
        "responses": { "200": { "description": "Templates list" } }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Runtime telemetry & metrics",
        "responses": { "200": { "description": "Metrics JSON" } }
      }
    },
    "/api/auth/token": {
      "post": {
        "summary": "Issue authentication token",
        "responses": { "200": { "description": "Token issued" } }
      }
    },
    "/api/protected": {
      "get": {
        "summary": "Protected resource",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Access granted" }, "401": { "description": "Unauthorized" } }
      }
    }
  }
}
